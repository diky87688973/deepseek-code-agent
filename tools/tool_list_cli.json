      },
      {
        "file": "inner_orch_common.py",
        "role": "内部公共模块：封装子进程调用与通用辅助能力，不单独对外暴露。"
      },
      {
        "file": "inner_orch_line_dual_anchor_purify.py",
        "chains": [
          "extract line",
          "可选 dropPhrases",
          "双锚截取",
          "可选尾截断"
        ],
        "cli": "--request-file path.json 或 --source-file + --line + --out-file",
        "request_schema_note": "JSON 字段 snake_case: source_file,line,out_file,encoding,json_out,drop_phrases,left_pattern,right_pattern,tail_cut_pattern,ignore_case,multiline,allow_no_left,allow_no_right,left_use_end_of_match,right_bound_is_match_end",
        "role": "内部预设执行脚本：行抽取 + 可选短语删除 + 双锚截取 + 可选尾截断。"
      }
    ],
    "high_freq_chains": [
      {
        "id": "orch_agent_pipeline",
        "use": "cli_orch_dispatch -> inner_orch_agent",
        "when": "需要多步有序编排，且希望统一展示中间过程与写前预览时。"
      },
      {
        "id": "line_purify_dual_anchor",
        "use": "cli_orch_dispatch(preset=line_dual_anchor) -> inner_orch_line_dual_anchor_purify",
        "when": "需要按行抽取后执行双锚清洗链路时。"
      }
    ]
