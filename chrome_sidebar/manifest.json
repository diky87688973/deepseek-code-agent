{
  "manifest_version": 3,
  "name": "Code Web Agent Sidebar",
  "version": "1.4",
  "description": "在浏览器侧边栏中使用 Code Web Agent",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:*"
  },
  "action": {
    "default_title": "打开 Code Web Agent 侧边栏",
    "default_icon": "icon16.png"
  }
}
