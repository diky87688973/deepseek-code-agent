{
  "version": "4.1",
  "title": "Text toolkit CLI catalog",
  "agent_hints": {
    "function_call_extras": {
      "usePreview": "OpenAI 函数 schema 顶层的 usePreview、step_title 由 code_web_agent 在组装 exec 参数时剥离，不进入各 cli_*.py 的 argv。cli_structured_edit 在 extract 的 payload 内可选字段 usePreview（布尔）表示是否对 data.text 走 cli_preview_render，属于脚本内部参数，与前述顶层字段不同。",
      "step_title": "步骤主标题，仅宿主/UI 使用，不传给子进程。"
    },
    "machine_readable_catalog": "唯一 JSON 清单为本文件 tool_list_cli.json。",
    "stdio_utf8": "各 cli_*.py 与 orch 入口在最早阶段调用 cli_stdio_utf8.install_stdio_utf8()，标准流尽量为 UTF-8；由 code_web_agent 等起的子进程另设 PYTHONUTF8=1 与 PYTHONIOENCODING=utf-8。",
    "encoding_convention": "工具库与 Code Web Agent：源文件、本清单、提示词、request/payload/outFile 等文本落盘一律 UTF-8（推荐无 BOM）。各 cli 若对子进程 stdout 等尝试 gbk/gb18030 解码，仅用于兼容不可控输出，与本项目磁盘默认编码无关。",
    "openapi_tool_name_rule": "catalog 中 name 去掉 .py 即为 function 名（如 cli_structured_edit）。",
    "cli_command_exec_policy": "【最低优先级】cli_command_exec 在 API tools 列表中排在末尾；仅当专用 cli_* 与 cli_python_inline 均无法合理覆盖且用户已当次授权执行命令时才用；默认传 safeMode=true。",
    "windows_powershell": {
      "prefer_stdin_payload": "长 JSON 用 --payloadStdin / --requestStdin，整段 JSON 从 stdin 读入。",
      "avoid_here_string_utf8": "含中文的大段替换文本不要放进 PowerShell here-string（@'...'@）再喂给 Python，易出现乱码；优先使用 UTF-8 的 requestFile、payloadFile（正文直接写中文），或在为 UTF-8 的 .py 源文件中写字符串与 Path；仅当终端无法可靠传递 UTF-8 时，再用 \\uXXXX 等 Unicode 转义。"
    },
    "recipes": {
      "read_full_file": "cli_structured_edit + payload {type:extract, mode:offsets, start:0, end:-1} + --file",
      "diff_markdown_fence": "需 Markdown diff 着色：用 cli_text_diff --jsonOut 的 data.diffMarkdown（内含 ```diff 围栏）；勿再外层套一层代码块。",
      "replace_block_by_markers": "cli_structured_edit --file <path> --jsonOut --requestStdin; payload {type:replace_markers,startMarker,endMarker,text,searchFrom?}; same as index+replace_range in one step.",
      "todo_list_query": "查询当前会话是否有执行清单：cli_todo_list action=query（无参数）。data 为 null 表示无清单；为数组 [{text,done},…] 表示有。禁止用 action=close 试探。"
    },
    "structured_edit": {
      "replace_markers": "大块替换优先 type=replace_markers：startMarker/endMarker 定半开区间，text 为新内容；可选 searchFrom 跳过文件头重复片段。",
      "replace_markers_anchor_exact": "startMarker/endMarker 须与文件内容逐字一致（含全角标点，如中文逗号 U+FF0C「，」≠半角「,」；读盘为 universal newlines/LF）。若报错 startMarker not found，勿猜：用 extract 或 cli_regex_locate 核对实际片段。",
      "avoid_ps_json": "PowerShell 下勿单行 --requestJson；用 Python json.dumps 打印到 stdout 再管道进 --requestStdin。",
      "unicode_path_in_script": "胶水脚本内访问含中文路径：源文件保存为 UTF-8，可直接写中文路径字面量或使用 Path 分段；必要时再用 \\uXXXX；也可把最终路径放入 CLI 的 --file。"
    }
  },
