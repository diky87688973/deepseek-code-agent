      },
      "payload_types": [
        "append",
        "append_line",
        "insert",
        "replace_range",
        "replace_literal",
        "replace_markers",
        "extract",
        "delete_segments"
      ],
      "payload_schema": {
        "append": {
          "required": [
            "type",
            "text"
          ],
          "type": "append"
        },
        "append_line": {
          "required": [
            "type",
            "text"
          ],
          "type": "append_line"
        },
        "insert": {
          "required": [
            "type",
            "text",
            "startLine",
            "startColumn"
          ],
          "type": "insert",
          "indexing": "行列 1-based"
        },
        "replace_range": {
          "required": [
            "type",
            "text",
            "start",
            "end"
          ],
          "type": "replace_range",
          "range": "[start, end)",
          "index_base": "0-based"
        },
        "replace_literal": {
          "required": [
            "type",
            "oldText",
            "newText"
          ],
          "optional": [
            "count"
          ],
          "type": "replace_literal"
        },
        "extract": {
          "required": [
            "type",
            "mode"
          ],
          "type": "extract",
          "modes": {
            "lines": {
              "range": "[startLine, endLine] 闭区间",
              "index_base": "行号 1-based",
              "fields": [
                "startLine",
                "endLine"
              ]
            },
            "lines_columns": {
              "range": "[startLine,startColumn] 到 [endLine,endColumn)，结束列开",
              "index_base": "行列 1-based",
              "fields": [
                "startLine",
                "startColumn",
                "endLine",
                "endColumn"
              ],
              "negative_end": "endColumn 可为 -1/-2 倒推"
            },
            "offsets": {
              "range": "[start, end)",
              "index_base": "0-based",
              "fields": [
                "start",
                "end"
              ],
              "negative_end": "end 可为 -1/-2 倒推"
            }
          },
          "optional": [
            "outFile",
            "encoding",
            "usePreview"
          ]
        },
        "delete_segments": {
          "required": [
            "type"
          ],
          "type": "delete_segments",
          "optional": [
            "masks",
            "dropPhrases",
            "outFile",
            "encoding"
          ],
          "masks_item": {
            "start": "int >=0",
            "end": "int >=0",
            "range": "[start,end) 半开，无负索引"
          },
          "constraint": "masks 与 dropPhrases 至少一项非空"
        },
        "replace_markers": {
          "required": [
            "type",
            "startMarker",
            "endMarker",
            "text"
          ],
          "optional": [
            "searchFrom"
          ],
          "type": "replace_markers",
          "range": "[index(startMarker), index(endMarker)) half-open; endMarker first match after startMarker",
          "index_base": "0-based char offsets"
        }
      },
